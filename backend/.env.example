# Port the API listens on
PORT=3000

# Origin allowed to call the API (the Angular dev server)
CORS_ORIGIN=http://localhost:4200

# Azure Cosmos DB (NoSQL API). Leave COSMOS_ENDPOINT empty to use the
# in-memory store, which keeps data only while the server runs.
#
# For the local Cosmos DB emulator use https://localhost:8081/ and the
# emulator's well-known key from the Microsoft docs.
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=simplebudge
